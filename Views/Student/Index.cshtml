@model STDMS.Models.StudentDirectoryViewModel
@{
    ViewData["Title"] = "Students";
}

<section class="page-heading d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <span class="panel-kicker">STUDENT DIRECTORY</span>
        <h1 class="h2 mb-1">Students</h1>
        <p class="text-muted mb-0">Search and browse student records by name, email, or department.</p>
    </div>
    @if (User.IsInRole(RoleNames.Administrator) || User.IsInRole(RoleNames.AcademicAdministrator))
    {
        <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-2" aria-hidden="true"></i>Add student</a>
    }
</section>

<form asp-action="Index" method="get" class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-6">
                <label for="student-search" class="form-label">Search students</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fas fa-search text-muted" aria-hidden="true"></i></span>
                    <input id="student-search" type="search" name="search" value="@Model.Search" class="form-control" placeholder="Name or email" />
                </div>
            </div>
            <div class="col-md-4">
                <label for="department-filter" class="form-label">Department</label>
                <select id="department-filter" name="departmentId" asp-items="Model.Departments" class="form-select">
                    <option value="">All departments</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Search</button>
                <a asp-action="Index" class="btn btn-outline-secondary" aria-label="Clear filters" title="Clear filters">
                    <i class="fas fa-xmark" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    </div>
</form>

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">
        @Model.TotalStudents @(Model.TotalStudents == 1 ? "student" : "students") found
        @if (Model.TotalPages > 0)
        {
            <span> · Page @Model.Page of @Model.TotalPages</span>
        }
    </p>
</div>

<div class="card border-0 shadow-sm">
    @if (Model.Students.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Student</th>
                        <th scope="col">Email</th>
                        <th scope="col">Date of birth</th>
                        <th scope="col">Department</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var student in Model.Students)
                    {
                        <tr>
                            <td data-label="Student">
                                <span class="student-avatar">@student.Name.Substring(0, 1).ToUpperInvariant()</span>
                                <span class="student-name">@student.Name</span>
                            </td>
                            <td data-label="Email">@student.Email</td>
                            <td data-label="Date of birth">@student.DateOfBirth.ToString("MMM d, yyyy")</td>
                            <td data-label="Department"><span class="badge bg-light text-dark">@student.Department?.Name</span></td>
                            <td class="text-end" data-label="Actions">
                                <div class="btn-group btn-group-sm" role="group" aria-label="Actions for @student.Name">
                                    <a asp-action="Details" asp-route-id="@student.Id" class="btn btn-outline-secondary">View</a>
                                    @if (User.IsInRole(RoleNames.Administrator) || User.IsInRole(RoleNames.AcademicAdministrator))
                                    {
                                        <a asp-action="Edit" asp-route-id="@student.Id" class="btn btn-outline-primary">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@student.Id" class="btn btn-outline-danger">Delete</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="card-body text-center py-5">
            <span class="empty-icon mb-3"><i class="fas fa-user-graduate" aria-hidden="true"></i></span>
            <h2 class="h5">No students found</h2>
            <p class="text-muted mb-0">Try another search or clear the department filter.</p>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-4" aria-label="Student directory pages">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-departmentId="@Model.DepartmentId" asp-route-page="@(Model.Page - 1)" aria-label="Previous page">Previous</a>
            </li>
            @for (var pageNumber = Model.FirstVisiblePage; pageNumber <= Model.LastVisiblePage; pageNumber++)
            {
                <li class="page-item @(pageNumber == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-departmentId="@Model.DepartmentId" asp-route-page="@pageNumber" aria-label="Page @pageNumber">@pageNumber</a>
                </li>
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-departmentId="@Model.DepartmentId" asp-route-page="@(Model.Page + 1)" aria-label="Next page">Next</a>
            </li>
        </ul>
    </nav>
}
