@model IEnumerable<STDMS.Models.Course>

@{
    ViewData["Title"] = "Courses";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Course Management</h2>
        @if (User.IsInRole(RoleNames.Administrator) || User.IsInRole(RoleNames.AcademicAdministrator))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i> Create New Course
            </a>
        }
    </div>

    @if (Model?.Any() == true)
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Course Name</th>
                                <th>Credits</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var course in Model)
                            {
                                <tr>
                                    <td>@course.Name</td>
                                    <td>
                                        <span class="badge bg-primary">@course.Credits Credits</span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@course.Id" class="btn btn-info btn-sm">Details</a>
                                            @if (User.IsInRole(RoleNames.Administrator) || User.IsInRole(RoleNames.AcademicAdministrator))
                                            {
                                                <a asp-action="Edit" asp-route-id="@course.Id" class="btn btn-warning btn-sm">Edit</a>
                                                <a asp-action="Delete" asp-route-id="@course.Id" class="btn btn-danger btn-sm">Delete</a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            <h4>No courses found</h4>
            @if (User.IsInRole(RoleNames.Administrator) || User.IsInRole(RoleNames.AcademicAdministrator))
            {
                <p>Start by <a asp-action="Create" class="alert-link">creating a new course</a>.</p>
            }
        </div>
    }
</div>
