@model IEnumerable<STDMS.Models.Department>

@{
    ViewData["Title"] = "Departments";
}

<h1>Departments</h1>

@if (User.IsInRole(RoleNames.Administrator) || User.IsInRole(RoleNames.AcademicAdministrator))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Add Department</a>
    </p>
}

<div class="table-responsive">
<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var dept in Model)
        {
            <tr>
                <td>@dept.Name</td>
                <td>
                    <a asp-action="Details" asp-route-id="@dept.Id" class="btn btn-info btn-sm">Details</a>
                    @if (User.IsInRole(RoleNames.Administrator) || User.IsInRole(RoleNames.AcademicAdministrator))
                    {
                        <a asp-action="Edit" asp-route-id="@dept.Id" class="btn btn-warning btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@dept.Id" class="btn btn-danger btn-sm">Delete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
