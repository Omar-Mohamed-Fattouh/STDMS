@model IEnumerable<STDMS.Models.Instructor>

@{
    ViewData["Title"] = "Instructors";
}

<h2>Instructors</h2>
@if (User.IsInRole(RoleNames.Administrator) || User.IsInRole(RoleNames.AcademicAdministrator))
{
    <a asp-action="Create" class="btn btn-primary mb-2">Create New Instructor</a>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Hire Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var instructor in Model)
        {
            <tr>
                <td>@instructor.Name</td>
                <td>@instructor.HireDate.ToShortDateString()</td>
                <td>
                    @if (User.IsInRole(RoleNames.Administrator) || User.IsInRole(RoleNames.AcademicAdministrator))
                    {
                        <a asp-action="Edit" asp-route-id="@instructor.Id" class="btn btn-warning btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@instructor.Id" class="btn btn-danger btn-sm">Delete</a>
                    }
                    <a asp-action="Details" asp-route-id="@instructor.Id" class="btn btn-info btn-sm">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
