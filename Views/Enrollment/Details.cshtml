@model STDMS.Models.Enrollment

@{
    ViewData["Title"] = "Enrollment Details";
}

<h2>Enrollment Details</h2>

<div>
    <dl class="row">
        <dt class="col-sm-2">Student:</dt>
        <dd class="col-sm-10">@Model.Student?.Name</dd>

        <dt class="col-sm-2">Course:</dt>
        <dd class="col-sm-10">@Model.Course?.Name</dd>

        <dt class="col-sm-2">Grade:</dt>
        <dd class="col-sm-10">@Model.Grade</dd>
    </dl>
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>
