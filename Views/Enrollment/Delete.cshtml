@model STDMS.Models.Enrollment

@{
    ViewData["Title"] = "Delete Enrollment";
}

<h2>Delete Enrollment</h2>

<div class="alert alert-danger">
    <h4>Are you sure you want to delete this enrollment?</h4>
</div>

<div>
    <dl class="row">
        <dt class="col-sm-2">Student:</dt>
        <dd class="col-sm-10">@Model.Student?.Name</dd>

        <dt class="col-sm-2">Course:</dt>
        <dd class="col-sm-10">@Model.Course?.Name</dd>

        <dt class="col-sm-2">Grade:</dt>
        <dd class="col-sm-10">@Model.Grade</dd>
    </dl>
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
