@model STDMS.Models.Attendance

@{
    ViewData["Title"] = "Delete Attendance";
}

<h2>Delete Attendance</h2>

<h3 class="h4">Are you sure you want to delete this record?</h3>

<div>
    <h4 class="h5">@Model.Student?.Name - @Model.Course?.Name on @Model.Date.ToShortDateString()</h4>

    <form asp-action="DeleteConfirmed">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
