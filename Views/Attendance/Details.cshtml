@model STDMS.Models.Attendance

@{
    ViewData["Title"] = "Attendance Details";
}

<h2>Attendance Details</h2>

<dl class="row">
    <dt class="col-sm-2">Student:</dt>
    <dd class="col-sm-10">@Model.Student?.Name</dd>

    <dt class="col-sm-2">Course:</dt>
    <dd class="col-sm-10">@Model.Course?.Name</dd>

    <dt class="col-sm-2">Date:</dt>
    <dd class="col-sm-10">@Model.Date.ToShortDateString()</dd>

    <dt class="col-sm-2">Is Present:</dt>
    <dd class="col-sm-10">@Model.IsPresent</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>
