@{
    ViewData["Title"] = "Welcome";
}

<div class="welcome">
    <section class="welcome-hero">
        <span class="welcome-badge"><i class="fas fa-graduation-cap me-2" aria-hidden="true"></i>STDMS School Manager</span>
        <h1>Your school,<br />beautifully organized.</h1>
        <p class="welcome-lead">
            Students, teachers, courses, enrollments and attendance — every record
            your school runs on, in one calm, modern, role-based workspace.
        </p>
        <div class="welcome-actions">
            <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Login">
                Sign in <i class="fas fa-arrow-right ms-1" aria-hidden="true"></i>
            </a>
            <a class="btn btn-outline-primary btn-lg" asp-controller="Account" asp-action="Register">Create an account</a>
        </div>
        <ul class="welcome-points">
            <li><i class="fas fa-circle-check" aria-hidden="true"></i> Live dashboard &amp; attendance insights</li>
            <li><i class="fas fa-circle-check" aria-hidden="true"></i> Records managed in seconds</li>
            <li><i class="fas fa-circle-check" aria-hidden="true"></i> Access tailored to every role</li>
        </ul>
    </section>

    <section class="welcome-modules" aria-labelledby="welcome-modules-title">
        <h2 id="welcome-modules-title">Everything a school office runs on</h2>
        <p class="welcome-section-lead">Seven connected modules that share one database and one sign-in.</p>

        <div class="welcome-grid">
            <article class="welcome-card">
                <span class="welcome-card-icon"><i class="fas fa-user-graduate" aria-hidden="true"></i></span>
                <h3>Students</h3>
                <p>A searchable student directory with department filters, pagination, and complete record management.</p>
            </article>
            <article class="welcome-card">
                <span class="welcome-card-icon"><i class="fas fa-building" aria-hidden="true"></i></span>
                <h3>Departments</h3>
                <p>Organize the school into academic departments and keep every record attached to the right one.</p>
            </article>
            <article class="welcome-card">
                <span class="welcome-card-icon"><i class="fas fa-book-open" aria-hidden="true"></i></span>
                <h3>Courses</h3>
                <p>Run the course catalogue with credit hours and quick paths into enrollments and attendance.</p>
            </article>
            <article class="welcome-card">
                <span class="welcome-card-icon"><i class="fas fa-chalkboard-user" aria-hidden="true"></i></span>
                <h3>Instructors</h3>
                <p>Track teaching staff and hire dates, with office assignments across buildings and rooms.</p>
            </article>
            <article class="welcome-card">
                <span class="welcome-card-icon"><i class="fas fa-user-check" aria-hidden="true"></i></span>
                <h3>Enrollments</h3>
                <p>Connect students to courses, record grades, and browse the full enrollment history with filters.</p>
            </article>
            <article class="welcome-card">
                <span class="welcome-card-icon"><i class="fas fa-calendar-check" aria-hidden="true"></i></span>
                <h3>Attendance</h3>
                <p>Daily class attendance with present and absent tracking, summaries, and course and date filters.</p>
            </article>
        </div>
    </section>

    <section class="welcome-roles" aria-labelledby="welcome-roles-title">
        <div class="welcome-roles-inner">
            <h2 id="welcome-roles-title">Built for the whole office</h2>
            <p>
                Administrators manage staff accounts and assignments, academic staff run the
                day-to-day records, instructors follow their classes, and read-only accounts
                can look without touching. Everyone signs in once and sees exactly their work.
            </p>
            <ul class="welcome-points welcome-points-light">
                <li><i class="fas fa-user-check" aria-hidden="true"></i> Role-based permissions</li>
                <li><i class="fas fa-circle-check" aria-hidden="true"></i> Fast, self-hosted, no CDNs</li>
                <li><i class="fas fa-lock" aria-hidden="true"></i> Secure staff sign-in</li>
            </ul>
            <a class="btn btn-light btn-lg" asp-controller="Account" asp-action="Register">Get started free</a>
        </div>
    </section>
</div>
