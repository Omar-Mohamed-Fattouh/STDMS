<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - STDMS</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="STDMS — Student & Teacher Data Management System. Manage students, instructors, courses, enrollments, office assignments and attendance in one modern, secure workspace." />
    <meta name="theme-color" content="#152A21" />
    @{
        // Always emit the public HTTPS origin: WhatsApp and similar crawlers
        // refuse http:// images, and IIS on MonsterASP can report the request
        // as HTTP even when the visitor arrived on HTTPS.
        const string OgOrigin = "https://stdms.runasp.net";
        var ogTitle = ViewData["Title"] is "Welcome" or "STDMS" or null
            ? "STDMS — Student & Teacher Data Management System"
            : $"{ViewData["Title"]} · STDMS";
        var ogDescription = "STDMS — Student & Teacher Data Management System. Manage students, instructors, courses, enrollments, office assignments and attendance in one modern, secure workspace.";
        var ogUrl = OgOrigin + Context.Request.Path;
        var ogImage = OgOrigin + "/og-image.png";
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="STDMS" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content="@ogTitle" />
    <meta property="og:description" content="@ogDescription" />
    <meta property="og:url" content="@ogUrl" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:image:secure_url" content="@ogImage" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="STDMS — Student & Teacher Data Management System" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@ogTitle" />
    <meta name="twitter:description" content="@ogDescription" />
    <meta name="twitter:image" content="@ogImage" />
    <link rel="canonical" href="@ogUrl" />
    <link rel="preload" href="~/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/inter-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/fraunces-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/fraunces-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/inter-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/STDMS.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" asp-append-version="true">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" asp-append-version="true">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" asp-append-version="true">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" asp-append-version="true">
</head>
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    string NavClass(string controller) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
            ? "app-nav-link active"
            : "app-nav-link";
}
<body class="@(isAuthenticated ? "app-body" : "auth-body")">

@if (isAuthenticated)
{
    <div class="app-shell">
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <aside class="app-sidebar" id="appSidebar" aria-label="Main navigation">
            <a class="app-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand-mark"><i class="fas fa-graduation-cap" aria-hidden="true"></i></span>
                <span class="app-brand-text">STDMS<small>School Manager</small></span>
            </a>

            <nav class="app-nav">
                <span class="app-nav-heading">Menu</span>
                @if (!User.IsInRole(RoleNames.Instructor))
                {
                    <a class="@NavClass("Home")" asp-controller="Home" asp-action="Index">
                        <i class="fas fa-house" aria-hidden="true"></i><span>Dashboard</span>
                    </a>
                    <a class="@NavClass("Student")" asp-controller="Student" asp-action="Index">
                        <i class="fas fa-user-graduate" aria-hidden="true"></i><span>Students</span>
                    </a>
                    <a class="@NavClass("Department")" asp-controller="Department" asp-action="Index">
                        <i class="fas fa-building" aria-hidden="true"></i><span>Departments</span>
                    </a>
                    <a class="@NavClass("Course")" asp-controller="Course" asp-action="Index">
                        <i class="fas fa-book-open" aria-hidden="true"></i><span>Courses</span>
                    </a>
                    <a class="@NavClass("Instructor")" asp-controller="Instructor" asp-action="Index">
                        <i class="fas fa-chalkboard-user" aria-hidden="true"></i><span>Instructors</span>
                    </a>
                    <a class="@NavClass("Enrollment")" asp-controller="Enrollment" asp-action="Index">
                        <i class="fas fa-clipboard-list" aria-hidden="true"></i><span>Enrollments</span>
                    </a>
                    <a class="@NavClass("OfficeAssignment")" asp-controller="OfficeAssignment" asp-action="Index">
                        <i class="fas fa-door-open" aria-hidden="true"></i><span>Office Assignments</span>
                    </a>
                }
                <a class="@NavClass("Attendance")" asp-controller="Attendance" asp-action="Index">
                    <i class="fas fa-calendar-check" aria-hidden="true"></i><span>Attendance</span>
                </a>

                @if (User.IsInRole(RoleNames.Administrator))
                {
                    <span class="app-nav-heading">Administration</span>
                    <a class="@NavClass("Admin")" asp-controller="Admin" asp-action="Users">
                        <i class="fas fa-users-gear" aria-hidden="true"></i><span>Staff accounts</span>
                    </a>
                }
            </nav>

            <div class="app-sidebar-user">
                <span class="user-avatar">@((User.Identity?.Name ?? "?").Trim()[0].ToString().ToUpperInvariant())</span>
                <span class="user-meta">
                    <strong title="@User.Identity?.Name">@User.Identity?.Name</strong>
                    <small>@(User.IsInRole(RoleNames.Administrator) ? "Administrator" : User.IsInRole(RoleNames.AcademicAdministrator) ? "Academic Admin" : User.IsInRole(RoleNames.Instructor) ? "Instructor" : "Staff")</small>
                </span>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-sidebar-logout" title="Sign out" aria-label="Sign out">
                        <i class="fas fa-right-from-bracket" aria-hidden="true"></i>
                    </button>
                </form>
            </div>
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <button type="button" class="btn btn-topbar-toggle" id="sidebarToggle" aria-label="Toggle navigation">
                    <i class="fas fa-bars" aria-hidden="true"></i>
                </button>
                <div class="app-topbar-title">
                    <h1>@(ViewData["Title"] ?? "STDMS")</h1>
                    <small>Student &amp; Teacher Data Management</small>
                </div>
                <div class="app-topbar-actions">
                    <span class="user-chip"><i class="fas fa-circle-user me-1" aria-hidden="true"></i>@User.Identity?.Name</span>
                </div>
            </header>

            <main class="app-content">
                <div class="app-content-inner">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show slide-in" role="alert">
                            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show slide-in" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["InfoMessage"] != null)
                    {
                        <div class="alert alert-info alert-dismissible fade show slide-in" role="alert">
                            <i class="fas fa-info-circle me-2"></i>@TempData["InfoMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @RenderBody()
                </div>
            </main>

            <footer class="app-footer">
                &copy; 2026 STDMS — Student &amp; Teacher Data Management System
                &middot; <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
            </footer>
        </div>
    </div>
}
else
{
    <header class="auth-header">
        <a class="app-brand auth-brand" asp-controller="Home" asp-action="Index">
            <span class="brand-mark"><i class="fas fa-graduation-cap" aria-hidden="true"></i></span>
            <span class="app-brand-text">STDMS<small>School Manager</small></span>
        </a>
        <nav class="auth-header-links">
            <a asp-controller="Account" asp-action="Login">Sign in</a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm px-3">Create account</a>
        </nav>
    </header>

    <main class="auth-main">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show slide-in auth-alert" role="alert">
                <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="auth-footer">
        &copy; 2026 STDMS — Student &amp; Teacher Data Management System
        &middot; <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
    </footer>
}

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js" asp-append-version="true" defer></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    <script>
        (function () {
            var toggle = document.getElementById('sidebarToggle');
            var sidebar = document.getElementById('appSidebar');
            var backdrop = document.getElementById('sidebarBackdrop');
            if (!toggle || !sidebar) return;
            function close() { sidebar.classList.remove('open'); backdrop && backdrop.classList.remove('show'); }
            toggle.addEventListener('click', function () {
                sidebar.classList.toggle('open');
                backdrop && backdrop.classList.toggle('show');
            });
            backdrop && backdrop.addEventListener('click', close);
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- Loading overlay -->
    <div id="loadingOverlay" class="position-fixed top-0 start-0 w-100 h-100 d-none" style="background: rgba(0,0,0,0.5); z-index: 9999;">
        <div class="d-flex justify-content-center align-items-center h-100">
            <div class="text-center text-white">
                <div class="loading mb-3"></div>
                <p>Loading...</p>
            </div>
        </div>
    </div>
</body>
</html>
