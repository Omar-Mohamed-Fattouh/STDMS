@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
    var statusCode = ViewData["StatusCode"] as int? ?? 500;
}

<div class="error-shell">
    <span class="error-icon error-icon-red"><i class="fas fa-triangle-exclamation" aria-hidden="true"></i></span>
    <span class="error-code">@statusCode</span>
    <h1>Something went wrong</h1>
    <p class="error-message">
        An unexpected error occurred while processing your request.
        Please try again in a moment — if the problem keeps happening,
        let your system administrator know what you were doing.
    </p>
    <div class="error-actions">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
            <i class="fas fa-house me-1" aria-hidden="true"></i> Back to dashboard
        </a>
        <button type="button" class="btn btn-outline-secondary" onclick="window.location.reload()">
            <i class="fas fa-arrow-left me-1" aria-hidden="true"></i> Try again
        </button>
    </div>
    @if (Model.ShowRequestId)
    {
        <p class="error-request-id">Request ID: <code>@Model.RequestId</code></p>
    }
</div>
