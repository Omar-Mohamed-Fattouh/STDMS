@model IEnumerable<STDMS.Models.OfficeAssignment>

@{
    ViewData["Title"] = "Office Assignments";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Office Assignments</h1>
        <p class="text-muted mb-0">Manage office locations for instructors.</p>
    </div>
    @if (User.IsInRole(RoleNames.Administrator) || User.IsInRole(RoleNames.AcademicAdministrator))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus me-2" aria-hidden="true"></i>Add office assignment
        </a>
    }
</div>

@if (Model.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Instructor</th>
                        <th scope="col">Office location</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var office in Model)
                    {
                        <tr>
                            <td class="fw-semibold" data-label="Instructor">@(office.Instructor?.Name ?? "Instructor unavailable")</td>
                            <td data-label="Office location">@office.Location</td>
                            <td class="text-end" data-label="Actions">
                                <div class="btn-group btn-group-sm" role="group" aria-label="Actions for @(office.Instructor?.Name ?? "office assignment")">
                                    <a asp-action="Details" asp-route-id="@office.InstructorId" class="btn btn-outline-secondary">Details</a>
                                    @if (User.IsInRole(RoleNames.Administrator) || User.IsInRole(RoleNames.AcademicAdministrator))
                                    {
                                        <a asp-action="Edit" asp-route-id="@office.InstructorId" class="btn btn-outline-primary">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@office.InstructorId" class="btn btn-outline-danger">Delete</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body py-5 text-center">
            <span class="d-inline-grid rounded-circle bg-light text-primary p-3 mb-3">
                <i class="fas fa-door-open fa-lg" aria-hidden="true"></i>
            </span>
            <h2 class="h5">No office assignments yet</h2>
            <p class="text-muted">Create an assignment to record an instructor's office location.</p>
            @if (User.IsInRole(RoleNames.Administrator) || User.IsInRole(RoleNames.AcademicAdministrator))
            {
                <a asp-action="Create" class="btn btn-primary">Add office assignment</a>
            }
        </div>
    </div>
}
