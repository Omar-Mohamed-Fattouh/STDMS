@model STDMS.Models.OfficeAssignment

@{
    ViewData["Title"] = "Delete Office Assignment";
}

<h2>Delete Office Assignment</h2>

<div class="alert alert-danger">
    <h3 class="h4">Are you sure you want to delete this office assignment?</h3>
</div>

<div>
    <dl class="row">
        <dt class="col-sm-2">Instructor:</dt>
        <dd class="col-sm-10">@Model.Instructor?.Name</dd>

        <dt class="col-sm-2">Location:</dt>
        <dd class="col-sm-10">@Model.Location</dd>
    </dl>
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="InstructorId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
